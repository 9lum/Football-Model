# Keep local .env ignored. Production credentials belong in GitHub Actions secrets.
ODDS_API_KEY=
BALLDLIE_API_KEY=
# BALLDONTLIE_API_KEY is accepted as an alternate spelling.
XWEATHER_API_KEY=
XWEATHER_CLIENT_ID=
DATABASE_URL=
API_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:3000
# Optional per-refresh odds credit cap (default is quota-aware).
ODDS_REFRESH_CREDIT_BUDGET=
POSTGRES_PASSWORD=
# Optional documented normalized licensed feeds; no subscriptions are purchased.
SPORTSDATAIO_FEED_URL=
SPORTSDATAIO_API_KEY=
PFF_FEED_URL=
PFF_API_KEY=
SPORTRADAR_FEED_URL=
SPORTRADAR_API_KEY=
NFL_TRACKING_FEED_URL=
NFL_TRACKING_API_KEY=
# Optional game-market refresh interval; quota-aware by default (minimum override: 15 minutes).
GAME_ODDS_REFRESH_MINUTES=
